---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';
---
<Base title="Page not found | Mirror Finish Mobile Detailing" description="That page is not here. Build your mobile detail or head back to the Mirror Finish home page." noindex>
  <Header />
  <main id="main" class="section">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1>That page <em>drove off.</em></h1>
      <p class="lead">The link may be old. You can still build your detail or text us at {SITE.phoneDisplay}.</p>
      <p><a class="btn btn--lg" href="/book"><span>Build my detail</span></a> <a class="btn btn--ghost btn--lg" href="/">Back to home</a></p>
    </div>
  </main>
  <Footer />
</Base>
