---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import '../styles/book.css';
import pass from '../assets/hf-pass.png';
const art = (await getImage({ src: pass, width: 880, format: 'webp' })).src;
const home = (Astro.site?.href ?? '').replace(/\/?$/, '/');
// Live checkout is on when the build knows the checkout function's URL (repo variable CHECKOUT_URL).
const live = !!import.meta.env.PUBLIC_CHECKOUT_URL;
const crumbs = { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: home }, { '@type': 'ListItem', position: 2, name: 'Book a detail', item: home + 'book/' }] };
---
<Base title="Book Mobile Detailing in Montgomery, AL | Mirror Finish MGM" description="Pick your vehicle, build your detail and see your price instantly. Book mobile car detailing in Montgomery, AL and the River Region with a 20% deposit." schema={[crumbs]}>
  <Header minimal />
  {!live && <div class="demo" role="note">PREVIEW — sample availability, no payment is taken</div>}
  <main id="main" class="book wrap">
    <h1 class="sr">Build and book your mobile detail</h1>
    <div id="app" data-pass-art={art} data-home="/">
      <div class="progress"><div id="bar" class="barline" aria-hidden="true"><i></i></div><nav id="stepper" class="stepper" aria-label="Booking steps"></nav></div>
      <div class="layout">
        <section id="panel" class="panel" aria-live="polite"></section>
        <aside class="side" aria-label="Your build">
          <div class="stage"><div id="viewer"></div><span id="vcar" class="vcar"></span><div id="vtag" class="vtag"></div></div>
          <div id="summary" class="summary"></div>
          <div class="nav2 only-d"><button id="back" class="btn btn--ghost" type="button" hidden>Back</button><button id="next" class="btn btn--lg" type="button">Continue</button></div>
        </aside>
      </div>
      <div class="mbar"><div id="mtotal" class="tot"></div><button id="mnext" class="btn" type="button">Next</button></div>
    </div>
  </main>
  <script>
    import { initBooking } from '../lib/booking';
    initBooking();
  </script>
</Base>
