---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';
import { packages, sizes, extras } from '../data/menu';
import { fmt } from '../lib/pricing';
import hero from '../assets/hf-hero.png';
import paint from '../assets/hf-paint.png';
import interior from '../assets/hf-interior.png';
import g1 from '../assets/ig_04.jpg';
import g2 from '../assets/ig_05.jpg';
import g3 from '../assets/ig_06.jpg';
import g4 from '../assets/ig_07.jpg';
import g5 from '../assets/ig_12.jpg';
import g6 from '../assets/ig_16.jpg';

const gallery = [
  { src: g1, alt: 'Freshly detailed dark GMC truck' },
  { src: g2, alt: 'Restored, clear truck headlight' },
  { src: g3, alt: 'Clean vehicle interior' },
  { src: g4, alt: 'Detailed black Audi' },
  { src: g5, alt: 'Detailed black sedan' },
  { src: g6, alt: 'Detailed Chevrolet sedan' },
];
const steps = [
  ['Tell us your vehicle', 'We detect the size and price instantly.'],
  ['Build your detail', 'Pick a package and any add-ons. The total updates live.'],
  ['Choose a time, pay 20%', 'Reserve your spot with a small deposit. The rest is due after.'],
];
---
<Base
  title="Mirror Finish Mobile Detailing MGM | Mobile Car Wash & Detailing in Montgomery, AL"
  description="Mobile car wash & detailing in Montgomery and the River Region. Mirror Finish Mobile Detailing delivers expert interior cleaning and exterior shine to your door. Build your detail and book online, or call/text 334-652-2601."
>
  <Header />
  <main id="main">
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Mobile detailing · Montgomery, AL</p>
          <h1>A mirror finish,<br />at your door.</h1>
          <p class="lead">{SITE.tagline}. Build your detail, see your price instantly, and book in minutes.</p>
          <p class="cta">
            <a class="btn" href="/book">Build my detail</a>
            <a class="btn btn--ghost" href={SITE.phoneSms}>Text {SITE.phoneDisplay}</a>
          </p>
          <ul class="facts"><li>We come to you</li><li>Instant price by vehicle</li><li>20% deposit books it</li></ul>
        </div>
        <Image class="hero-img" src={hero} alt="Glossy black SUV in a bright showroom" widths={[480, 720, 1000]} sizes="(min-width: 900px) 560px, 100vw" loading="eager" />
      </div>
    </section>

    <section id="packages" class="section">
      <div class="wrap">
        <p class="eyebrow">Packages</p>
        <h2>Choose your detail</h2>
        <div class="grid3">
          {packages.map((p) => (
            <article class="card pkg">
              {p.badge && <em class="badge">{p.badge}</em>}
              <h3>{p.name}</h3>
              <p class="price">{fmt(p.cents)}</p>
              <ul class="feat">{p.features.map((f) => <li>{f}</li>)}</ul>
              <a class="btn btn--dark" href={`/book?pkg=${p.id}`}>Build {p.name}</a>
            </article>
          ))}
        </div>
        <div class="split">
          <div>
            <h3>Priced to your vehicle</h3>
            <p class="muted">Package prices are for a sedan or coupe. Larger vehicles add a size charge, and the booking tool works it out for you.</p>
            <table class="tbl"><caption class="sr">Vehicle size add-ons</caption><tbody>
              {sizes.map((r) => (<tr><th scope="row">{r.name}</th><td>{r.cents ? '+' + fmt(r.cents) : '$0'}</td></tr>))}
            </tbody></table>
            <p><a class="btn" href="/book">Find my price</a></p>
          </div>
          <Image class="split-img" src={paint} alt="Mirror-finish black paint with water beads" widths={[360, 600]} sizes="(min-width: 900px) 480px, 100vw" loading="lazy" />
        </div>
      </div>
    </section>

    <section id="extras" class="section tint">
      <div class="wrap">
        <p class="eyebrow">Add-ons</p>
        <h2>Make it yours</h2>
        <div class="grid2">
          {extras.map((e) => (
            <article class="card ext"><div><h3>{e.name}</h3><p class="muted">{e.blurb}</p></div><b>+{fmt(e.cents)}</b></article>
          ))}
        </div>
        <p><a class="btn btn--dark" href="/book">Add to my build</a></p>
      </div>
    </section>

    <section id="how" class="section band">
      <div class="wrap">
        <p class="eyebrow">How it works</p>
        <h2>Booked in three steps</h2>
        <ol class="steps">
          {steps.map(([t, d], i) => (<li><span class="num" aria-hidden="true">{i + 1}</span><h3>{t}</h3><p class="muted">{d}</p></li>))}
        </ol>
        <p><a class="btn" href="/book">Start now</a></p>
      </div>
    </section>

    <section id="gallery" class="section">
      <div class="wrap">
        <p class="eyebrow">Recent work</p>
        <h2>Results you can see</h2>
        <div class="gal">
          {gallery.map((g) => (<Image src={g.src} alt={g.alt} width={480} height={480} widths={[240, 480, 720]} sizes="(min-width: 900px) 360px, 50vw" loading="lazy" />))}
        </div>
        <p><a class="btn btn--dark" href="/book">Book yours</a></p>
      </div>
    </section>

    <section id="areas" class="section tint">
      <div class="wrap split">
        <div>
          <p class="eyebrow">Service area</p>
          <h2>Where we go</h2>
          <ul class="chips">{SITE.serviceArea.map((c) => <li class="chip">{c}, {SITE.region}</li>)}</ul>
        </div>
        <Image class="split-img" src={interior} alt="Clean black leather interior" widths={[360, 600]} sizes="(min-width: 900px) 480px, 100vw" loading="lazy" />
      </div>
    </section>

    <section class="section band final">
      <div class="wrap">
        <h2>Ready for a spotless ride?</h2>
        <p class="lead">Build your detail in about a minute.</p>
        <p class="cta"><a class="btn" href="/book">Build my detail</a><a class="btn btn--ghost" href={SITE.phoneSms}>Call / Text {SITE.phoneDisplay}</a></p>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <p class="eyebrow">Not ready yet?</p>
        <h2>No problem</h2>
        <div class="grid4">
          <a class="card alt" href={SITE.phoneSms}><b>Text a question</b><span class="muted">{SITE.phoneDisplay}</span></a>
          <a class="card alt" href="#gallery"><b>See recent work</b><span class="muted">Real jobs from around town.</span></a>
          <a class="card alt" href="#areas"><b>Check your area</b><span class="muted">8 towns and counting.</span></a>
          <a class="card alt" href={SITE.instagramUrl}><b>Follow on Instagram</b><span class="muted">@mfmd_mgm</span></a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <div class="sticky" role="region" aria-label="Quick actions"><a class="btn" href="/book">Build my detail</a><a class="btn btn--dark" href={SITE.phoneSms}>Call / Text</a></div>

  <style>
    .hero { padding: var(--s6) 0 var(--s7); }
    .hero-grid { display: grid; gap: var(--s6); align-items: center; }
    .cta { display: flex; flex-wrap: wrap; gap: var(--s3); margin: var(--s5) 0; }
    .facts { list-style: none; display: flex; flex-wrap: wrap; gap: var(--s2) var(--s5); padding: 0; margin: 0; font-weight: 600; font-size: .9rem; }
    .facts li::before { content: ''; display: inline-block; width: var(--s2); height: var(--s2); border-radius: 50%; background: var(--gold); margin-right: var(--s2); }
    .hero-img, .split-img { border-radius: var(--radius); width: 100%; height: auto; box-shadow: var(--shadow); object-fit: cover; }
    .hero-img { aspect-ratio: 4 / 3; }
    .split-img { aspect-ratio: 4 / 3; max-height: 460px; }
    .grid3, .grid2, .grid4 { display: grid; gap: var(--s4); margin: var(--s5) 0; }
    .pkg { position: relative; display: grid; gap: var(--s2); align-content: start; }
    .badge { position: absolute; top: calc(var(--s3) * -1); right: var(--s4); background: var(--gold); color: var(--black); font: 700 .7rem var(--font); letter-spacing: .08em; text-transform: uppercase; padding: var(--s1) var(--s3); border-radius: var(--radius-pill); font-style: normal; }
    .feat { margin: 0 0 var(--s3); padding-left: 1.1em; color: var(--muted); }
    .split { display: grid; gap: var(--s6); align-items: center; margin-top: var(--s7); }
    .tbl { width: 100%; border-collapse: collapse; margin: var(--s3) 0 var(--s5); }
    .tbl th, .tbl td { padding: var(--s3) 0; border-bottom: 1px solid var(--line-light); text-align: left; font-weight: 500; }
    .tbl td { text-align: right; font-weight: 800; }
    .ext { display: flex; justify-content: space-between; gap: var(--s4); align-items: start; }
    .ext p { margin: 0; }
    .steps { list-style: none; padding: 0; margin: var(--s5) 0; display: grid; gap: var(--s5); }
    .num { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--gold); color: var(--black); font-weight: 800; margin-bottom: var(--s3); }
    .gal { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--s3); margin: var(--s5) 0; }
    .gal img { border-radius: var(--radius); aspect-ratio: 1; object-fit: cover; width: 100%; }
    .chips { list-style: none; padding: 0; margin: var(--s4) 0 0; display: flex; flex-wrap: wrap; gap: var(--s2); }
    .final { text-align: center; } .final .cta { justify-content: center; } .final .lead { margin-inline: auto; }
    .alt { display: grid; gap: var(--s1); text-decoration: none; transition: border-color var(--t) var(--ease); }
    .alt:hover { border-color: var(--black); }
    .sticky { position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; display: flex; gap: var(--s3); padding: var(--s3) var(--s4) calc(var(--s3) + env(safe-area-inset-bottom)); background: var(--scrim-light); border-top: 1px solid var(--line-light); }
    .sticky .btn { flex: 1; }
    @media (min-width: 900px) {
      .hero { padding: var(--s8) 0; }
      .hero-grid { grid-template-columns: 1fr 1.05fr; gap: var(--s8); }
      .grid3 { grid-template-columns: repeat(3, 1fr); } .grid2 { grid-template-columns: repeat(2, 1fr); } .grid4 { grid-template-columns: repeat(4, 1fr); }
      .split { grid-template-columns: 1fr 1fr; gap: var(--s8); }
      .steps { grid-template-columns: repeat(3, 1fr); }
      .gal { grid-template-columns: repeat(3, 1fr); gap: var(--s4); }
      .sticky { display: none; }
    }
    @media (max-width: 899px) { .foot { padding-bottom: 110px; } }
  </style>
</Base>
