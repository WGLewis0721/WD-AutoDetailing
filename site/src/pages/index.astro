---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';
import { packages, sizes, extras } from '../data/menu';
import { fmt } from '../lib/pricing';
import { icon } from '../lib/icons';
import { bodyStyles, makes } from '../lib/vehicles';
import hero from '../assets/hf-hero.png';
import paint from '../assets/hf-paint.png';
import interior from '../assets/hf-interior.png';
import g1 from '../assets/ig_04.jpg';
import g2 from '../assets/ig_05.jpg';
import g3 from '../assets/ig_06.jpg';
import g4 from '../assets/ig_07.jpg';
import g5 from '../assets/ig_12.jpg';
import g6 from '../assets/ig_16.jpg';

const gallery = [
  { src: g1, alt: 'Freshly detailed dark GMC truck', cls: 'tall' },
  { src: g4, alt: 'Detailed black Audi', cls: '' },
  { src: g2, alt: 'Restored, clear truck headlight', cls: '' },
  { src: g5, alt: 'Detailed black sedan', cls: 'wide' },
  { src: g3, alt: 'Clean vehicle interior', cls: '' },
  { src: g6, alt: 'Detailed Chevrolet sedan', cls: '' },
];
const steps = [
  ['Tell us your vehicle', 'Pick the year, make and model. We set the size and price for you.'],
  ['Build your detail', 'Choose a package and any add-ons. Your total updates as you go.'],
  ['Pick a time, pay 20%', 'Reserve your spot with a small deposit. The rest is due after the detail.'],
];
const faqs = [
  ['Do you really come to me?', 'Yes. Mirror Finish is mobile. We detail your vehicle where it is parked, at home or at work, across Montgomery and the River Region.'],
  ['How does pricing work?', 'Each package has a base price for a sedan or coupe. Larger vehicles add a size charge, from $20 for a small SUV or truck up to $60 for a van, 3-row SUV or HD truck. Add-ons are priced separately.'],
  ['What is the deposit?', 'You pay 20% of your total to reserve the time. The rest is due after the detail. The final price can vary with vehicle condition and size after inspection.'],
  ['Can I book more than one vehicle?', 'Yes. You can add up to four vehicles to one order and choose a package for each.'],
  ['Where do you serve?', `${SITE.serviceArea.join(', ')}, AL. Not sure if you are in range? Text ${SITE.phoneDisplay}.`],
];
const addonIcons = ['droplet', 'sparkle', 'shield', 'wand'];
/* Renders of the same 3D meshes the booking tool uses, all at one scale so the size classes compare honestly. */
const renders = import.meta.glob<{ default: ImageMetadata }>('../assets/sizes/*.png', { eager: true });
const render = (key: string) => renders[`../assets/sizes/${key}.png`].default;
const towns = SITE.serviceArea.join(', ').replace(/, ([^,]*)$/, ' and $1');
const faqSchema = { '@type': 'FAQPage', mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) };
---
<Base
  title="Mobile Car Wash & Detailing in Montgomery, AL | Mirror Finish MGM"
  description="Mobile car detailing in Montgomery, AL and the River Region. Mirror Finish comes to your home or work: interior and exterior details from $40. See your price and book online, or text 334-652-2601."
  schema={[faqSchema]}
>
  <Header />
  <main id="main">
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <h1 class="reveal"><span class="eyebrow kicker">Mobile car detailing in Montgomery, AL</span>A <em>Mirror Finish,</em><br />at your door.</h1>
          <p class="lead reveal" style="--d:160ms">{SITE.tagline}. Tell us your vehicle, build your detail, and see your price before you book.</p>
          <form class="quick card reveal" style="--d:240ms" id="quick" data-book="/book" aria-label="Get an instant price">
            <p class="quick-t"><span>Get your price</span><small>Takes about a minute</small></p>
            <div class="field"><label for="qcity">Your town</label><select id="qcity"><option value="">Select town</option>{SITE.serviceArea.map((c) => <option value={c}>{c}, {SITE.region}</option>)}</select></div>
            <div class="quick-row">
              <div class="field"><label for="qmake">Make</label><select id="qmake"><option value="">Select make</option>{makes.map((m) => <option>{m}</option>)}</select></div>
              <div class="field"><label for="qmodel">Model</label><select id="qmodel" disabled><option value="">Select model</option></select></div>
            </div>
            <button class="btn btn--dark btn--lg" type="submit"><span>See my price</span><Fragment set:html={icon('arrow', 20)} /></button>
          </form>
          <ul class="trust reveal" style="--d:320ms">
            <li><Fragment set:html={icon('home', 18)} />We come to you</li>
            <li><Fragment set:html={icon('clock', 18)} />Instant pricing</li>
            <li><Fragment set:html={icon('shield', 18)} />20% deposit books it</li>
          </ul>
        </div>
        <div class="hero-art reveal" style="--d:200ms">
          <div class="hero-frame"><Image class="hero-img" src={hero} alt="Glossy black SUV with a mirror-finish detail" widths={[480, 720, 1000]} sizes="(min-width: 900px) 520px, 100vw" loading="eager" fetchpriority="high" /><span class="shine" aria-hidden="true"></span></div>
          <div class="float f1"><Fragment set:html={icon('pin', 18)} /><span>{SITE.serviceArea.length} towns served</span></div>
          <div class="float f2"><small>Deluxe detail from</small><b class="num">{fmt(packages[0].cents)}</b></div>
        </div>
      </div>
    </section>

    <div class="marquee" aria-hidden="true">
      <div class="track">
        {[0, 1].map(() => <span>{SITE.serviceArea.map((c) => <i>{c}</i>)}</span>)}
      </div>
    </div>

    <section id="packages" class="section">
      <div class="wrap">
        <div class="head reveal"><p class="eyebrow">Packages</p><h2>Three ways to <em>shine</em></h2><p class="lead">Pick the mobile detail that fits. Every package is done at your home or workplace, anywhere in the River Region.</p></div>
        <div class="pkgs">
          {packages.map((p, i) => (
            <article class={`pkg reveal ${p.id === 'deluxe' ? 'pkg--feature' : ''}`} style={`--d:${i * 90}ms`}>
              {p.badge && <em class="badge">{p.badge}</em>}
              <h3>{p.name}</h3>
              <p class="price num">{fmt(p.cents)}</p>
              <ul class="feat">{p.features.map((f) => <li><Fragment set:html={icon('check', 18)} />{f}</li>)}</ul>
              <a class={`btn ${p.id === 'deluxe' ? '' : 'btn--dark'}`} href={`/book?pkg=${p.id}`}><span>Build {p.name}</span><Fragment set:html={icon('arrow', 18)} /></a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="sizes" class="section tint">
      <div class="wrap wide">
        <div class="head reveal"><p class="eyebrow">Pricing by size</p><h2>Priced to <em>your vehicle</em></h2><p class="lead">Package prices are for a sedan or coupe. Larger vehicles add a size charge, and the booking tool works it out for you.</p></div>
        <div class="fit reveal">
          <div class="fit-form card" id="fit" data-book="/book">
            <p class="boxt">Your vehicle</p>
            <div class="quick-row">
              <div class="field"><label for="fmake">Make</label><select id="fmake"><option value="">Select make</option>{makes.map((m) => <option>{m}</option>)}</select></div>
              <div class="field"><label for="fmodel">Model</label><select id="fmodel" disabled><option value="">Select model</option></select></div>
            </div>
            <p class="fit-or">Or pick a body style</p>
            <div class="fit-chips" role="radiogroup" aria-label="Body style">
              {bodyStyles.map((b, i) => <button type="button" class={i === 0 ? 'pick on' : 'pick'} role="radio" aria-checked={i === 0 ? 'true' : 'false'} data-style={b.id} data-model={b.model} data-size={b.size}>{b.label}</button>)}
            </div>
          </div>
          <div class="fit-side">
            <div class="fit-stage" id="fitstage">
              {bodyStyles.map((b, i) => <Image class="fit-img" data-key={b.model} src={render(b.model)} alt={b.label + ', for example ' + b.examples} widths={[480, 944]} sizes="(min-width: 900px) 760px, 100vw" loading={i === 0 ? 'eager' : 'lazy'} hidden={i !== 0} />)}
              <span class="fit-drag" id="fithint">Swipe to compare</span>
            </div>
            <ul class="tierbar" aria-label="Size classes and prices">
              {sizes.map((s, i) => <li class={i === 0 ? 'on' : ''} data-size={s.id} data-name={s.name} data-price={s.cents ? '+' + fmt(s.cents) : ''}><span>{s.short}</span><b class="num">{s.cents ? '+' + fmt(s.cents) : 'Included'}</b></li>)}
            </ul>
            <p class="fit-res" id="fitres" aria-live="polite">Sedan &amp; Coupe: the package price as listed.</p>
            <p class="fit-go"><a class="btn btn--dark btn--lg" id="fitgo" href="/book?style=sedan"><span>Build this detail</span><Fragment set:html={icon('arrow', 20)} /></a></p>
          </div>
        </div>
      </div>
    </section>

    <section id="extras" class="section">
      <div class="wrap split">
        <div>
          <div class="head reveal"><p class="eyebrow">Add-ons</p><h2>Make it <em>yours</em></h2><p class="lead">Add any of these to any package. Pricing is per vehicle.</p></div>
          <ul class="menu">
            {extras.map((e, i) => (
              <li class="reveal" style={`--d:${i * 70}ms`}>
                <span class="mi"><Fragment set:html={icon(addonIcons[i % 4], 22)} /></span>
                <div><b>{e.name}</b><small>{e.blurb}</small></div>
                <span class="dots" aria-hidden="true"></span>
                <b class="num">+{fmt(e.cents)}</b>
              </li>
            ))}
          </ul>
          <p class="reveal"><a class="btn btn--dark" href="/book"><span>Add to my build</span><Fragment set:html={icon('arrow', 18)} /></a></p>
        </div>
        <Image class="split-img reveal" src={paint} alt="Mirror-finish black paint with water beads" widths={[360, 600]} sizes="(min-width: 900px) 480px, 100vw" loading="lazy" />
      </div>
    </section>

    <section id="how" class="section band">
      <div class="wrap">
        <div class="head reveal"><p class="eyebrow">How it works</p><h2>Booked in <em>three steps</em></h2></div>
        <ol class="steps">
          {steps.map(([t, d], i) => (<li class="reveal" style={`--d:${i * 100}ms`}><span class="bignum" aria-hidden="true">{i + 1}</span><h3>{t}</h3><p class="muted">{d}</p></li>))}
        </ol>
        <p class="reveal"><a class="btn btn--lg" href="/book"><span>Start now</span><Fragment set:html={icon('arrow', 20)} /></a></p>
      </div>
    </section>

    <section id="gallery" class="section">
      <div class="wrap">
        <div class="head reveal"><p class="eyebrow">Recent work</p><h2>Results you can <em>see</em></h2></div>
        <div class="gal">
          {gallery.map((g, i) => (<figure class={`reveal ${g.cls}`} style={`--d:${(i % 3) * 80}ms`}><Image src={g.src} alt={g.alt} width={640} height={640} widths={[320, 640, 960]} sizes="(min-width: 900px) 380px, 50vw" loading="lazy" /></figure>))}
        </div>
      </div>
    </section>

    <section id="areas" class="section tint">
      <div class="wrap split split--flip">
        <Image class="split-img reveal" src={interior} alt="Clean black leather interior" widths={[360, 600]} sizes="(min-width: 900px) 480px, 100vw" loading="lazy" />
        <div>
          <div class="head reveal"><p class="eyebrow">Service area</p><h2>Where we <em>go</em></h2><p class="lead">Mobile detailing at your home or workplace in {towns}, Alabama. Not on the list? Text us.</p></div>
          <ul class="chips reveal">{SITE.serviceArea.map((c) => <li class="chip"><Fragment set:html={icon('pin', 14)} />{c}, {SITE.region}</li>)}</ul>
        </div>
      </div>
    </section>

    <section id="faq" class="section">
      <div class="wrap narrow">
        <div class="head reveal"><p class="eyebrow">Questions</p><h2>Good to <em>know</em></h2></div>
        <div class="faq">
          {faqs.map(([q, a]) => (<details class="reveal"><summary>{q}<Fragment set:html={icon('plus', 20)} /></summary><p>{a}</p></details>))}
        </div>
      </div>
    </section>

    <section class="section band final">
      <Image class="final-bg" src={paint} alt="" widths={[480, 900]} sizes="100vw" loading="lazy" />
      <div class="wrap final-in">
        <h2 class="reveal">Ready for a <em>spotless</em> ride?</h2>
        <p class="lead reveal" style="--d:80ms">Build your detail in about a minute.</p>
        <p class="cta reveal" style="--d:160ms"><a class="btn btn--lg" href="/book"><span>Build my detail</span><Fragment set:html={icon('arrow', 20)} /></a><a class="btn btn--ghost btn--lg" href={SITE.phoneSms}>Text {SITE.phoneDisplay}</a></p>
        <ul class="alts reveal" style="--d:240ms"><li><a href="#gallery">See recent work</a></li><li><a href="#areas">Check your area</a></li><li><a href={SITE.instagramUrl}>Follow on Instagram</a></li></ul>
      </div>
    </section>
  </main>
  <Footer />
  <div class="sticky" role="region" aria-label="Quick actions"><a class="btn" href="/book"><span>Build my detail</span><Fragment set:html={icon('arrow', 18)} /></a><a class="btn btn--dark" href={SITE.phoneSms}>Text us</a></div>

  <script>
    import { modelsFor } from '../lib/vehicles';
    const form = document.getElementById('quick') as HTMLFormElement | null;
    if (form) {
      const make = document.getElementById('qmake') as HTMLSelectElement;
      const model = document.getElementById('qmodel') as HTMLSelectElement;
      make.addEventListener('change', () => {
        const list = modelsFor(make.value);
        model.innerHTML = '<option value="">Select model</option>' + list.map((m) => `<option>${m.name}</option>`).join('');
        model.disabled = list.length === 0;
      });
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const q = new URLSearchParams();
        const city = (document.getElementById('qcity') as HTMLSelectElement).value;
        if (city) q.set('city', city);
        if (make.value) q.set('make', make.value);
        if (model.value) q.set('model', model.value);
        location.href = (form.dataset.book ?? '/book') + (q.toString() ? '?' + q.toString() : '');
      });
    }

    /* Size finder: the same make/model and body-style picker as the booking tool, with the 3D mesh loaded only when the section is reached. */
    import { bodyStyles } from '../lib/vehicles';
    const fit = document.getElementById('fit');
    if (fit) {
      const fmake = document.getElementById('fmake') as HTMLSelectElement;
      const fmodel = document.getElementById('fmodel') as HTMLSelectElement;
      const stage = document.getElementById('fitstage')!;
      const res = document.getElementById('fitres')!;
      const go = document.getElementById('fitgo') as HTMLAnchorElement;
      const book = fit.dataset.book ?? '/book';
      const show = (model: string, size: string, query: string) => {
        stage.querySelectorAll<HTMLElement>('.fit-img').forEach((i) => { i.hidden = i.dataset.key !== model; });
        document.querySelectorAll<HTMLElement>('.tierbar li').forEach((li) => {
          const on = li.dataset.size === size; li.classList.toggle('on', on);
          if (on) res.textContent = li.dataset.price ? li.dataset.name + ': ' + li.dataset.price + ' added to any package.' : li.dataset.name + ': the package price as listed.';
        });
        go.href = book + '?' + query;
      };
      fmake.addEventListener('change', () => {
        const list = modelsFor(fmake.value);
        fmodel.innerHTML = '<option value="">Select model</option>' + list.map((m) => '<option>' + m.name + '</option>').join('');
        fmodel.disabled = list.length === 0;
      });
      fmodel.addEventListener('change', () => {
        const m = modelsFor(fmake.value).find((x) => x.name === fmodel.value);
        if (!m) return;
        fit.querySelectorAll('.pick').forEach((b) => { b.classList.remove('on'); b.setAttribute('aria-checked', 'false'); });
        show(m.model, m.size, new URLSearchParams({ make: fmake.value, model: m.name }).toString());
      });
      fit.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest<HTMLElement>('.pick');
        if (!b) return;
        fit.querySelectorAll('.pick').forEach((x) => { x.classList.toggle('on', x === b); x.setAttribute('aria-checked', String(x === b)); });
        fmake.value = ''; fmodel.innerHTML = '<option value="">Select model</option>'; fmodel.disabled = true;
        const s = bodyStyles.find((x) => x.id === b.dataset.style)!;
        show(s.model, s.size, 'style=' + s.id);
      });
      /* Touch screens skip three.js: stills swap instantly and a swipe on the stage steps through the body styles. */
      const desktop = window.matchMedia('(min-width: 900px) and (hover: hover)').matches;
      const hint = document.getElementById('fithint')!;
      if (desktop) hint.hidden = true;
      const step = (dir: number) => {
        const picks = [...fit.querySelectorAll<HTMLElement>('.pick')];
        const cur = picks.findIndex((p) => p.classList.contains('on'));
        const nextPick = picks[(Math.max(cur, 0) + dir + picks.length) % picks.length];
        nextPick.click();
        nextPick.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
      };
      let x0 = 0, y0 = 0;
      stage.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; }, { passive: true });
      stage.addEventListener('touchend', (e) => {
        if (desktop) return;
        const dx = e.changedTouches[0].clientX - x0, dy = e.changedTouches[0].clientY - y0;
        if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.5) step(dx < 0 ? 1 : -1);
      }, { passive: true });
    }
  </script>

  <style>
    .hero { padding: var(--s6) 0 var(--s8); overflow: hidden; }
    .hero-grid { display: grid; gap: var(--s7); align-items: center; }
    .quick { margin: var(--s6) 0 var(--s5); padding: var(--s5); box-shadow: var(--shadow); max-width: 34rem; display: grid; gap: var(--s2); }
    .quick-t { display: flex; justify-content: space-between; align-items: baseline; margin: 0 0 var(--s2); font-weight: 800; }
    .quick-t small { font-weight: 500; color: var(--muted); }
    .quick-row { display: grid; gap: 0 var(--s3); }
    .quick .field { margin-bottom: var(--s3); }
    .trust { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: var(--s3) var(--s5); font-weight: 600; font-size: var(--fs-sm); }
    .trust li { display: inline-flex; align-items: center; gap: var(--s2); }
    .trust .ic { color: var(--gold-deep); }
    h1 .kicker { display: flex; font-family: var(--font); line-height: 1.4; margin-bottom: var(--s5); }
    .hero-art { position: relative; }
    .hero-frame { position: relative; overflow: hidden; border-radius: var(--radius-lg); box-shadow: var(--shadow); }
    .hero-frame .hero-img { border-radius: 0; box-shadow: none; animation: drift 16s ease-in-out infinite alternate; transform-origin: 60% 60%; }
    /* The loop: a band of light crosses the paint every few seconds, like a reflection moving over a polished panel. */
    .shine { position: absolute; inset: -20% -60%; background: linear-gradient(100deg, transparent 42%, var(--shine-soft) 47%, var(--shine) 50%, var(--shine-soft) 53%, transparent 58%); transform: translateX(-60%); animation: sweep 6.5s cubic-bezier(.4, 0, .2, 1) infinite; mix-blend-mode: screen; pointer-events: none; }
    @keyframes sweep { 0%, 18% { transform: translateX(-60%); } 62%, 100% { transform: translateX(60%); } }
    @keyframes drift { from { transform: scale(1); } to { transform: scale(1.07); } }
    @keyframes bob { from { transform: translateY(0); } to { transform: translateY(-7px); } }
    .float { animation: bob 4.5s ease-in-out infinite alternate; }
    .f2 { animation-delay: -2.2s; }
    .hero-img { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; }
    .float { position: absolute; display: flex; align-items: center; gap: var(--s2); background: var(--scrim-light); backdrop-filter: blur(10px); border: 1px solid var(--line-light); border-radius: var(--radius-pill); padding: var(--s2) var(--s4); font-weight: 700; font-size: var(--fs-sm); box-shadow: var(--shadow-sm); }
    .f1 { top: var(--s5); right: var(--s4); }
    .f2 { bottom: var(--s5); left: var(--s4); border-radius: var(--radius); flex-direction: column; align-items: flex-start; gap: 0; padding: var(--s3) var(--s4); }
    .f2 small { font-weight: 500; color: var(--muted); } .f2 b { font-family: var(--font-display); font-size: 2rem; font-weight: 400; line-height: 1; }
    .marquee { background: var(--black); color: var(--white); overflow: hidden; border-block: 1px solid var(--line-dark); }
    .track { display: flex; width: max-content; animation: slide 38s linear infinite; }
    .track span { display: flex; }
    .track i { font-style: normal; font-family: var(--font-display); font-size: 1.6rem; padding: var(--s4) var(--s6); white-space: nowrap; }
    .track i::after { content: '◆'; color: var(--gold); font-size: .6em; margin-left: var(--s6); vertical-align: middle; }
    @keyframes slide { to { transform: translateX(-50%); } }
    .head { max-width: 40rem; margin-bottom: var(--s7); }
    .pkgs { display: grid; gap: var(--s4); }
    .pkg { position: relative; display: grid; gap: var(--s3); align-content: start; background: var(--white); border: 1px solid var(--line-light); border-radius: var(--radius-lg); padding: var(--s6); transition: transform .3s var(--ease), box-shadow .3s var(--ease); }
    .pkg:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
    .pkg h3 { margin: 0; font-size: var(--fs-xl); }
    .pkg .price { margin: 0; }
    .pkg--feature { background: var(--black); color: var(--white); border-color: var(--black); }
    .pkg--feature .feat { color: var(--muted-on-dark); } .pkg--feature .price { color: var(--gold-hi); }
    .badge { position: absolute; top: var(--s5); right: var(--s5); background: var(--gold); color: var(--black); font: 700 var(--fs-xs) var(--font); letter-spacing: .1em; text-transform: uppercase; padding: var(--s1) var(--s3); border-radius: var(--radius-pill); font-style: normal; }
    .feat { list-style: none; margin: var(--s2) 0 var(--s4); padding: 0; display: grid; gap: var(--s2); color: var(--muted); }
    .feat li { display: flex; gap: var(--s3); align-items: flex-start; }
    .feat .ic { color: var(--gold-deep); margin-top: 3px; } .pkg--feature .feat .ic { color: var(--gold-hi); }
    .wide { max-width: min(1560px, 100%); }
    .fit { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s4); }
    .fit-form { min-width: 0; overflow: hidden; }
    /* Phones: stage first, then a one-row swipeable rail of body styles. Stills only, so it is instant. */
    .fit-side { display: contents; }
    .fit-stage { order: 1; } .fit-form { order: 2; } .tierbar { order: 3; } .fit-res { order: 4; } .fit-go { order: 5; margin: 0; }
    .fit-stage { touch-action: pan-y; }
    .fit-form { align-self: start; box-shadow: var(--shadow-sm); }
    .boxt { font: 700 var(--fs-xs) var(--font); letter-spacing: .14em; text-transform: uppercase; color: var(--gold-deep); margin-bottom: var(--s4); }
    .fit-or { font-weight: 700; font-size: var(--fs-sm); margin: var(--s3) 0; }
    .fit-chips { display: flex; gap: var(--s2); overflow-x: auto; scroll-snap-type: x proximity; scrollbar-width: none; margin: 0 calc(var(--s6) * -1); padding: var(--s1) var(--s6) var(--s2); }
    .fit-chips::-webkit-scrollbar { display: none; }
    .fit-chips .pick { flex: none; scroll-snap-align: center; white-space: nowrap; }
