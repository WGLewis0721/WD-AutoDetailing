---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
import { packages, sizes, extras } from '../data/menu';
import logo from '../assets/logo.webp';
import pricelist from '../assets/pricelist.png';
import flierCar from '../assets/flier-car.jpg';
import hero from '../assets/ig_08.jpg';
import g1 from '../assets/ig_04.jpg';
import g2 from '../assets/ig_05.jpg';
import g3 from '../assets/ig_06.jpg';
import g4 from '../assets/ig_07.jpg';
import g5 from '../assets/ig_12.jpg';
import g6 from '../assets/ig_16.jpg';

const gallery = [
  { src: g1, alt: 'Freshly detailed dark GMC truck' },
  { src: g2, alt: 'Restored, clear truck headlight' },
  { src: g3, alt: 'Clean vehicle interior' },
  { src: g4, alt: 'Detailed black Audi' },
  { src: g5, alt: 'Detailed black sedan' },
  { src: g6, alt: 'Detailed Chevrolet sedan' },
];
const steps = [
  ['Pick a package', 'Choose Deluxe, Exterior or Interior, then your vehicle size.'],
  ['Choose a time', 'Book your spot online on our Square scheduling page.'],
  ['We come to you', 'We arrive at your location and get to work.'],
];
---
<Base
  title="Mirror Finish Mobile Detailing MGM | Mobile Car Wash & Detailing in Montgomery, AL"
  description="Mobile car wash & detailing in Montgomery and the River Region. Mirror Finish Mobile Detailing delivers expert interior cleaning and exterior shine to your door. Book online or call/text 334-652-2601."
>
  <header class="top">
    <div class="wrap bar">
      <a class="brand" href="/" aria-label={SITE.name}>
        <Image src={logo} alt="" width={112} height={112} loading="eager" /><span>{SITE.name}</span>
      </a>
      <nav aria-label="Main">
        <a href="#packages">Packages</a>
        <a href="#extras">Extras</a>
        <a href="#gallery">Gallery</a>
        <a href="#areas">Areas</a>
      </nav>
      <div class="actions">
        <a class="btn ghost sm" href={SITE.phoneSms}>Call / Text</a>
        <a class="btn sm" href={SITE.bookingUrl}>Book now</a>
      </div>
    </div>
  </header>

  <main id="main">
    <section class="hero">
      <div class="wrap hero-grid">
        <div>
          <p class="eyebrow">Mobile detailing · Montgomery, AL</p>
          <h1>We come to you.</h1>
          <p class="lead">{SITE.tagline}. Pick a package, book a time, and we detail your vehicle right where you are.</p>
          <p class="cta">
            <a class="btn" href={SITE.bookingUrl}>Book now</a>
            <a class="btn ghost" href={SITE.phoneSms}>Text {SITE.phoneDisplay}</a>
          </p>
          <p class="small">Prefer to talk? <a href={SITE.phoneTel}>Call {SITE.phoneDisplay}</a></p>
        </div>
        <Image class="hero-img" src={hero} alt="Freshly detailed white BMW SUV" widths={[480, 720, 960]} sizes="(min-width: 860px) 460px, 100vw" loading="eager" />
      </div>
    </section>

    <section id="packages">
      <div class="wrap">
        <p class="eyebrow">Packages</p>
        <h2>Pick your detail</h2>
        <div class="cards">
          {packages.map((p) => (
            <article class="card">
              <h3>{p.name}</h3>
              <p class="price">{p.price}</p>
              <ul class="feat">{p.features.map((f) => <li>{f}</li>)}</ul>
              <a class="btn" href={SITE.bookingUrl}>Book {p.name}</a>
            </article>
          ))}
        </div>
        <h3 class="sub">Vehicle size</h3>
        <p class="small">Package prices are for a sedan or coupe. Add the size charge for larger vehicles.</p>
        <table class="tbl">
          <caption class="sr">Vehicle size add-ons</caption>
          <tbody>
            {sizes.map((r) => (<tr><th scope="row">{r.name}</th><td>{r.price}</td></tr>))}
          </tbody>
        </table>
        <figure class="price-fig">
          <Image src={pricelist} alt="Mirror Finish Mobile Detailing price list: Deluxe $60, Exterior $40, Interior $40, with vehicle size add-ons" widths={[360, 503]} sizes="(min-width: 860px) 400px, 100%" loading="lazy" />
          <figcaption class="small">Our current price list. <a href={SITE.bookingUrl}>Book on Square</a></figcaption>
        </figure>
      </div>
    </section>

    <section id="extras" class="alt">
      <div class="wrap">
        <p class="eyebrow">Extras</p>
        <h2>Ask about our add-ons</h2>
        <table class="tbl">
          <caption class="sr">Extra services</caption>
          <tbody>
            {extras.map((r) => (
              <tr><th scope="row">{r.name}{r.note && <span class="note"> ({r.note})</span>}</th><td>{r.price}</td></tr>
            ))}
          </tbody>
        </table>
        <p class="small">Not sure what your vehicle needs? Call or text us and we will help.</p>
      </div>
    </section>

    <section id="how">
      <div class="wrap">
        <p class="eyebrow">How it works</p>
        <h2>Three easy steps</h2>
        <ol class="steps">
          {steps.map(([t, d], i) => (
            <li class="card"><span class="num" aria-hidden="true">{i + 1}</span><h3>{t}</h3><p>{d}</p></li>
          ))}
        </ol>
      </div>
    </section>

    <section id="gallery" class="alt">
      <div class="wrap">
        <p class="eyebrow">Recent work</p>
        <h2>Gallery</h2>
        <div class="grid">
          {gallery.map((g) => (<Image src={g.src} alt={g.alt} width={480} height={480} widths={[240, 480, 720]} sizes="(min-width: 860px) 360px, 50vw" loading="lazy" />))}
        </div>
      </div>
    </section>

    <section id="areas">
      <div class="wrap">
        <p class="eyebrow">Service area</p>
        <h2>Where we go</h2>
        <ul class="chips">{SITE.serviceArea.map((c) => <li>{c}, {SITE.region}</li>)}</ul>
      </div>
    </section>

    <section class="final">
      <Image class="final-bg" src={flierCar} alt="" widths={[480, 800]} sizes="100vw" loading="lazy" />
      <div class="wrap final-inner">
        <h2>Ready for a spotless ride?</h2>
        <p class="cta">
          <a class="btn" href={SITE.bookingUrl}>Book now</a>
          <a class="btn ghost" href={SITE.phoneSms}>Call / Text {SITE.phoneDisplay}</a>
        </p>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap">
      <p>© {new Date().getFullYear()} {SITE.name} (MGM) · Montgomery, AL · <a href={SITE.phoneTel}>{SITE.phoneDisplay}</a></p>
    </div>
  </footer>

  <div class="sticky" role="region" aria-label="Quick actions">
    <a class="btn" href={SITE.bookingUrl}>Book now</a>
    <a class="btn ghost" href={SITE.phoneSms}>Call / Text</a>
  </div>

  <style>
    .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .top { position: sticky; top: 0; z-index: 20; background: rgba(11,11,12,.94); border-bottom: 1px solid var(--line); backdrop-filter: blur(8px); }
    .bar { display: flex; align-items: center; gap: 20px; min-height: 68px; }
    .brand { display: flex; align-items: center; gap: 10px; color: var(--text); text-decoration: none; font-weight: 800; line-height: 1.1; font-size: .95rem; }
    .brand img { height: 52px; width: 52px; border-radius: 8px; }
    nav { display: none; gap: 20px; margin-left: auto; }
    nav a { color: var(--muted); text-decoration: none; font-weight: 600; }
    nav a:hover { color: var(--text); }
    .actions { display: flex; gap: 8px; margin-left: auto; }
    .btn.sm { min-height: 40px; padding: 0 14px; font-size: .9rem; }
    .actions .ghost { display: none; }
    .hero { padding-top: 40px; }
    .hero-grid { display: grid; gap: 28px; align-items: center; }
    .lead { color: var(--muted); font-size: 1.1rem; max-width: 34em; }
    .cta { display: flex; flex-wrap: wrap; gap: 12px; margin: 22px 0 8px; }
    .small { color: var(--muted); font-size: .92rem; }
    .hero-img { border-radius: var(--radius); border: 1px solid var(--line); aspect-ratio: 4 / 3; object-fit: cover; width: 100%; }
    .alt { background: var(--surface); }
    .cards { display: grid; gap: 16px; margin-top: 22px; }
    .card { background: var(--surface-2); border: 1px solid var(--line); border-radius: var(--radius); padding: 22px; }
    .alt .card { background: var(--bg); }
    .card h3 { margin-bottom: .2em; }
    .price-fig { margin: 36px 0 0; max-width: 400px; }
    .price-fig img { border-radius: var(--radius); border: 1px solid var(--line); }
    .feat { margin: 0 0 18px; padding-left: 1.1em; color: var(--muted); }
    .price { font-size: 2rem; font-weight: 800; color: var(--gold-hi); margin: 0 0 .4em; }
    .sub { margin-top: 36px; }
    .tbl { width: 100%; border-collapse: collapse; margin-top: 14px; }
    .tbl th, .tbl td { padding: 12px 6px; border-top: 1px solid var(--line); text-align: left; font-weight: 500; }
    .tbl td { text-align: right; font-weight: 700; color: var(--gold-hi); white-space: nowrap; padding-left: 16px; }
    .note { color: var(--muted); font-weight: 400; }
    .steps { list-style: none; margin: 22px 0 0; padding: 0; display: grid; gap: 16px; }
    .num { display: inline-flex; width: 34px; height: 34px; align-items: center; justify-content: center; border-radius: 50%; background: var(--gold); color: var(--on-gold); font-weight: 800; margin-bottom: 10px; }
    .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-top: 22px; }
    .grid img { border-radius: var(--radius); aspect-ratio: 1; object-fit: cover; width: 100%; }
    .chips { list-style: none; margin: 18px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
    .chips li { border: 1px solid var(--line); background: var(--surface); padding: 8px 16px; border-radius: 999px; }
    .final { text-align: center; background: var(--surface); position: relative; overflow: hidden; }
    .final-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: .28; }
    .final-inner { position: relative; }
    .final .cta { justify-content: center; }
    footer { padding: 28px 0 96px; color: var(--muted); border-top: 1px solid var(--line); text-align: center; }
    .sticky { position: fixed; left: 0; right: 0; bottom: 0; z-index: 30; display: flex; gap: 10px; padding: 10px 16px calc(10px + env(safe-area-inset-bottom)); background: rgba(11,11,12,.96); border-top: 1px solid var(--line); }
    .sticky .btn { flex: 1; }
    @media (min-width: 860px) {
      nav { display: flex; }
      .actions { margin-left: 0; }
      .actions .ghost { display: inline-flex; }
      .hero-grid { grid-template-columns: 1.1fr .9fr; gap: 48px; }
      .cards, .steps { grid-template-columns: repeat(3, 1fr); }
      .grid { grid-template-columns: repeat(3, 1fr); gap: 14px; }
      .sticky { display: none; }
      footer { padding-bottom: 28px; }
      section { padding: 80px 0; }
    }
  </style>
</Base>
